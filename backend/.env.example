# Copy this file to a new file named ".env" and fill in your own values.
# Never upload the real .env file to GitHub.

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/bookshelf
# MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster-url>/bookshelf
MONGODB_URI=mongodb://127.0.0.1:27017/bookshelf
